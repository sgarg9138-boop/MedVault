# MedVault Environment Configuration
# Copy this file to .env.local and replace with your actual keys from your Supabase dashboard

# 1. Supabase Credentials (from https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Supabase Storage Bucket Name (Created automatically by supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=medvault-records-private

# 3. Optional: AI Medical Insights Provider Key (for live parsing beyond demo mock engine)
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
